# ===== 서버 전용 환경변수 (브라우저에 노출되지 않음) =====
# 이 파일을 복사해 .env 로 만들고 실제 키를 넣으세요.
# .env 는 절대 GitHub 에 올리지 마세요 (.gitignore 에 포함됨).

# 발급받은 API 키 (sk- 로 시작)
API_KEY=sk-발급받은-키

# AI 게이트웨이 주소
AI_BASE_URL=https://52.79.201.46/v1

# 사용할 모델 별칭
AI_MODEL=bedrock-haiku

# API 프록시 서버 포트
PORT=8787

# 호출 타임아웃(ms) / 재시도 횟수
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
