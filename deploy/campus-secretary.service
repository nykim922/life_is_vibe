# ===== 캠퍼스 비서 백엔드 systemd 서비스 =====
# 역할: EC2 재부팅/프로세스 종료 시 Express 백엔드를 자동 재시작한다.
#
# 설치:
#   sudo cp deploy/campus-secretary.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now campus-secretary
#   sudo systemctl status campus-secretary
#   journalctl -u campus-secretary -f   # 로그 확인
#
# 전제:
#   - 앱 코드가 /var/www/campus-secretary 에 배포됨
#   - server/ 에서 `npm ci && npm run build` 로 dist 생성됨
#   - server/.env 에 실제 환경변수(GOOGLE_CLIENT_ID 등) 작성됨
#   - SESSION_DB_DIR(예: /var/lib/campus-secretary) 를 아래 User 가 쓸 수 있어야 함

[Unit]
Description=Campus Secretary Backend (Express + Google Calendar API)
After=network.target

[Service]
Type=simple
# 보안을 위해 전용 사용자 사용 권장 (예: sudo useradd -r -s /usr/sbin/nologin campus)
User=campus
Group=campus

WorkingDirectory=/var/www/campus-secretary/server
# 프로덕션 실행: 빌드된 dist/index.js 를 직접 실행
ExecStart=/usr/bin/node dist/index.js

Environment=NODE_ENV=production
# 애플리케이션이 루트 .env(기존 AI 설정)와 server/.env(Google 설정)를 직접 로드한다.

Restart=on-failure
RestartSec=3

# 세션/토큰 저장 디렉터리 쓰기 권한 (SESSION_DB_DIR 와 일치)
ReadWritePaths=/var/lib/campus-secretary

# 하드닝(선택)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
