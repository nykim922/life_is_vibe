# ===== 캠퍼스 비서 Nginx 설정 예시 (단일 EC2) =====
# 역할:
#  1) React 정적 파일(dist) 서빙 + SPA 라우팅 fallback
#  2) /api 요청을 내부 Express(127.0.0.1:4000)로 리버스 프록시
#  3) HTTPS 종료 (certbot 으로 인증서 발급 후 자동 구성 가능)
#
# 배치: /etc/nginx/sites-available/campus-secretary  → sites-enabled 로 심볼릭 링크
#   sudo ln -s /etc/nginx/sites-available/campus-secretary /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# 아래 your-domain.example.com 을 실제 도메인으로 바꾸세요.
# 도메인/인증서가 아직 없으면 먼저 HTTP(80)로 올린 뒤 certbot 으로 HTTPS 를 붙이면 됩니다.

# HTTP → HTTPS 리다이렉트 (인증서 발급 후 사용)
server {
    listen 80;
    server_name your-domain.example.com;

    # certbot 갱신용 (인증서 발급 전에는 이 블록만으로 HTTP 서비스 가능)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 인증서 발급 후에는 아래 주석을 풀어 HTTPS 로 리다이렉트
    # return 301 https://$host$request_uri;

    # --- 인증서 발급 전 임시 HTTP 서비스용 (발급 후 삭제 권장) ---
    root /var/www/campus-secretary/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# HTTPS 서버 (certbot 이 이 블록을 자동 생성/보완해 줄 수도 있음)
server {
    listen 443 ssl http2;
    server_name your-domain.example.com;

    # certbot 발급 인증서 경로 (예시)
    ssl_certificate     /etc/letsencrypt/live/your-domain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example.com/privkey.pem;

    # React 빌드 결과물
    root /var/www/campus-secretary/dist;
    index index.html;

    # gzip (선택)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml;

    # /api → 내부 Express (외부에 4000 포트를 직접 열지 않는다)
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # secure 쿠키가 올바로 동작하도록 프로토콜 전달 (Express trust proxy 와 함께)
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # SPA 라우팅: 정적 파일이 없으면 index.html 로 fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 정적 자산 캐시 (해시 파일명이라 장기 캐시 가능)
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
