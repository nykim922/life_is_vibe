# ===== 캠퍼스 비서 Nginx HTTP 설정 예시 (단일 EC2) =====
# 역할:
#  1) React 정적 파일(dist) 제공 + SPA fallback
#  2) /api 요청을 내부 Express(127.0.0.1:8787)로 전달
#
# 이 파일은 인증서가 없어도 시작할 수 있는 HTTP 전용 설정이다.
# Google OAuth 운영 연동 전에는 신뢰 가능한 도메인/인증서를 준비한 뒤
# 별도의 443 server block을 추가하고 80을 HTTPS로 리디렉션해야 한다.

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /var/www/campus-secretary/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 40s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
